# Copy to .env and fill in. This file stays on your computer only.

# Claude API key for captions (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=

# GoPro Cloud token: gopro.com/media-library -> F12 -> Application -> Cookies -> gp_access_token
# You can also paste it in the dashboard whenever it expires.
GOPRO_ACCESS_TOKEN=
